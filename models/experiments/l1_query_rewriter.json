{
  "experiment_name": "l1_query_rewriter_t5",
  "model_id": "L1",
  "tier": "repository_library_search_stack",
  "backbone": {
    "type": "encoder_decoder",
    "base_model": "google/flan-t5-base",
    "adapter_type": "lora",
    "parameters_millions": 250,
    "cache_dir": "/data/checkpoints",
    "load_in_8bit": false,
    "load_in_4bit": false
  },
  "dataset": {
    "sources": [
      "github_repos"
    ],
    "filters": {
      "years": [
        2000,
        2026
      ]
    },
    "construction": {
      "max_samples": 4000,
      "train_val_test_split": [
        0.9,
        0.1,
        0.0
      ],
      "shuffling_seed": 42,
      "input_fields": [
        "raw_query",
        "retrieval_context"
      ],
      "target_fields": [
        "normalized_query",
        "expanded_queries"
      ]
    },
    "quality_filters": {
      "code_min_chars": 64,
      "code_max_chars": 1000000,
      "papers_min_chars": 256
    },
    "tokenization": {
      "tokenizer_name": "google/flan-t5-base",
      "max_source_tokens": 256,
      "max_target_tokens": 256,
      "truncate_strategy": "longest_first"
    },
    "cache_dir": "/data/checkpoints"
  },
  "training": {
    "batch_size": 2,
    "gradient_accumulation_steps": 8,
    "num_epochs": 3,
    "learning_rate": 5e-05,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "warmup_steps": 100,
    "precision": "bf16",
    "gradient_checkpointing": true,
    "objective": "cross_entropy",
    "checkpoint_dir": "models/checkpoints/L1",
    "cache_dir": "/data/checkpoints",
    "finetune_strategy": "peft_lora",
    "use_hf_trainer": true,
    "max_steps": 1000,
    "allow_cpu_trainer": true,
    "force_cpu": false,
    "save_steps": 200,
    "logging_steps": 50,
    "eval_strategy": "no",
    "evaluation_strategy": "no",
    "load_best_model_at_end": false,
    "resume_from_checkpoint": false,
    "model_type": "seq2seq"
  },
  "evaluation": {
    "metrics": [
      "recall_at_10",
      "ndcg_at_10"
    ]
  },
  "inference": {
    "beam_size": 1,
    "max_new_tokens": 128,
    "temperature": 0.2,
    "top_p": 0.95
  },
  "notes": "Search-stack role added to match models.md coverage; dataset builder may need role-specific supervised labels before promotion."
}

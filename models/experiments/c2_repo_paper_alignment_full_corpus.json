{
  "experiment_name": "c2_repo_paper_alignment_full_corpus",
  "model_id": "C2",
  "tier": "T5_cross",
  "backbone": {
    "type": "decoder",
    "base_model": "meta-llama/Llama-3.2-1B",
    "adapter_type": "lora",
    "parameters_millions": 1000,
    "cache_dir": "/data/checkpoints",
    "load_in_8bit": true,
    "load_in_4bit": false
  },
  "dataset": {
    "sources": [
      "corpus_pairs"
    ],
    "corpus_dir": "exports/corpus",
    "quality_filters": {
      "pairs_min_chars": 256,
      "pairs_max_chars": 131072
    },
    "tokenization": {
      "tokenizer_name": "meta-llama/Llama-3.2-1B",
      "max_source_tokens": 2048,
      "max_target_tokens": 512,
      "truncate_strategy": "longest_first"
    },
    "cache_dir": "/data/checkpoints"
  },
  "training": {
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "num_epochs": 1,
    "learning_rate": 0.0001,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "warmup_steps": 1000,
    "precision": "bf16",
    "gradient_checkpointing": true,
    "objective": "contrastive",
    "checkpoint_dir": "models/checkpoints/c2_full_corpus",
    "cache_dir": "/data/checkpoints",
    "finetune_strategy": "peft_lora",
    "use_hf_trainer": true,
    "max_steps": 30000,
    "eval_split": 0.01,
    "allow_cpu_trainer": true,
    "force_cpu": false,
    "save_steps": 5000,
    "logging_steps": 200,
    "eval_strategy": "steps",
    "eval_steps": 5000,
    "evaluation_strategy": "steps",
    "metric_for_best_model": "eval_loss",
    "load_best_model_at_end": true
  },
  "evaluation": {
    "metrics": [
      "recall_at_10",
      "ndcg_at_10"
    ],
    "eval_interval_steps": 5000,
    "early_stopping": {
      "metric": "validation_loss",
      "patience": 2
    }
  },
  "inference": {
    "max_new_tokens": 256,
    "temperature": 0.7,
    "top_p": 0.95,
    "beam_size": 1
  },
  "compute": {
    "gpus": [
      {
        "type": "A100",
        "count": 8,
        "memory_gb": 80
      }
    ],
    "estimated_gpu_hours": 0,
    "distributed_strategy": "ddp"
  }
}



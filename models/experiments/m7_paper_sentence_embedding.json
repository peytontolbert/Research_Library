{
  "experiment_name": "m7_paper_sentence_embedding",
  "model_id": "M7",
  "tier": "T3_paper_text",
  "backbone": {
    "type": "encoder",
    "base_model": "allenai/scibert_scivocab_uncased",
    "adapter_type": "lora",
    "parameters_millions": 110,
    "cache_dir": "/data/checkpoints",
    "load_in_8bit": true,
    "load_in_4bit": false
  },
  "dataset": {
    "sources": [
      "paper_text_parquet"
    ],
    "filters": {
      "years": [
        2000,
        2025
      ]
    },
    "quality_filters": {
      "papers_min_chars": 1024,
      "papers_max_chars": 131072,
      "require_full_text": true
    },
    "construction": {
      "paper_dataset_dir": "/data/paper_text_2m_dedup_v1",
      "paper_dataset_id": "local/paper_text_2m_dedup_v1",
      "paper_universe_dir": "exports/_paper_universe",
      "input_fields": [
        "title",
        "abstract",
        "text"
      ],
      "target_fields": [
        "sentence_embedding"
      ],
      "teacher_embeddings": "fulltext",
      "max_query_sentences": 3,
      "max_body_sentences": 16,
      "max_samples": 0,
      "train_val_test_split": [
        0.8,
        0.1,
        0.1
      ],
      "shuffling_seed": 42
    },
    "tokenization": {
      "tokenizer_name": "allenai/scibert_scivocab_uncased",
      "max_source_tokens": 384,
      "max_target_tokens": 64,
      "truncate_strategy": "longest_first"
    },
    "cache_dir": "/data/checkpoints"
  },
  "training": {
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "num_epochs": 3,
    "learning_rate": 0.0001,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "warmup_steps": 1000,
    "precision": "bf16",
    "gradient_checkpointing": true,
    "objective": "contrastive",
    "contrastive_margin": 0.2,
    "distillation_weight": 0.1,
    "checkpoint_dir": "models/checkpoints/m7",
    "cache_dir": "/data/checkpoints",
    "finetune_strategy": "peft_lora",
    "use_hf_trainer": true,
    "allow_cpu_trainer": true,
    "force_cpu": false,
    "max_steps": 1000,
    "save_steps": 200,
    "logging_steps": 50,
    "eval_strategy": "steps",
    "eval_steps": 200,
    "evaluation_strategy": "steps",
    "metric_for_best_model": "eval_loss",
    "load_best_model_at_end": false,
    "model_type": "contrastive"
  },
  "evaluation": {
    "metrics": [
      "recall_at_10",
      "ndcg_at_10"
    ],
    "eval_interval_steps": 200,
    "early_stopping": {
      "metric": "validation_loss",
      "patience": 2
    }
  },
  "inference": {
    "max_new_tokens": 64,
    "temperature": 0.1,
    "top_p": 0.95,
    "beam_size": 1
  },
  "compute": {
    "gpus": [
      {
        "type": "RTX_3090",
        "count": 4,
        "memory_gb": 24
      }
    ],
    "estimated_gpu_hours": 0,
    "distributed_strategy": "ddp"
  }
}

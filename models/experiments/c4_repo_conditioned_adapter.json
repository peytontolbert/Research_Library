{
  "experiment_name": "c4_repo_conditioned_adapter_draft",
  "model_id": "C4",
  "tier": "T5_cross",
  "backbone": {
    "type": "encoder_decoder",
    "base_model": "google/flan-t5-base",
    "adapter_type": "lora",
    "parameters_millions": 250,
    "cache_dir": "/data/checkpoints",
    "load_in_8bit": false,
    "load_in_4bit": false
  },
  "dataset": {
    "sources": [
      "github_repos"
    ],
    "filters": {
      "years": [
        2000,
        2025
      ]
    },
    "construction": {
      "input_fields": [
        "repo_embedding"
      ],
      "target_fields": [
        "adapter_weights"
      ],
      "max_samples": 4000,
      "train_val_test_split": [
        0.9,
        0.1,
        0.0
      ],
      "shuffling_seed": 42
    },
    "tokenization": {
      "tokenizer_name": "google/flan-t5-base",
      "max_source_tokens": 512,
      "max_target_tokens": 256,
      "truncate_strategy": "longest_first"
    },
    "cache_dir": "/data/checkpoints"
  },
  "training": {
    "batch_size": 2,
    "gradient_accumulation_steps": 8,
    "num_epochs": 3,
    "learning_rate": 5e-05,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "warmup_steps": 100,
    "precision": "bf16",
    "gradient_checkpointing": true,
    "objective": "cross_entropy",
    "checkpoint_dir": "models/checkpoints/C4",
    "cache_dir": "/data/checkpoints",
    "finetune_strategy": "peft_lora",
    "use_hf_trainer": true,
    "max_steps": 1000,
    "allow_cpu_trainer": true,
    "force_cpu": false,
    "save_steps": 200,
    "logging_steps": 50,
    "eval_strategy": "no",
    "eval_steps": 200,
    "evaluation_strategy": "no",
    "metric_for_best_model": "eval_loss",
    "load_best_model_at_end": false,
    "resume_from_checkpoint": false,
    "model_type": "seq2seq"
  },
  "evaluation": {
    "metrics": [
      "perplexity"
    ],
    "eval_interval_steps": 200,
    "early_stopping": {
      "metric": "validation_loss",
      "patience": 2
    }
  },
  "inference": {
    "max_new_tokens": 256,
    "temperature": 0.7,
    "top_p": 0.95,
    "beam_size": 1
  },
  "compute": {
    "gpus": [
      {
        "type": "RTX_3090",
        "count": 4,
        "memory_gb": 24
      }
    ],
    "estimated_gpu_hours": 0,
    "distributed_strategy": "ddp"
  }
}
